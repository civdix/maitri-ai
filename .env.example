# Backend
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite:///data/app.db
FACE_DB_PATH=data/face_db.json

# Models
VIDEO_EMOTION_MODEL_PATH=models/vision/fer.onnx
USE_CUDA=false
VOSK_MODEL_PATH=models/vosk/en-in
# Piper voices
PIPER_VOICE_PATH_EN=models/piper/en_IN/en_IN-amy-low.onnx
PIPER_VOICE_CONFIG_EN=models/piper/en_IN/en_IN-amy-low.onnx.json
PIPER_VOICE_PATH_HI=models/piper/hi_IN/hi_IN-anu-low.onnx
PIPER_VOICE_CONFIG_HI=models/piper/hi_IN/hi_IN-anu-low.onnx.json

# LLM (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
ASSISTANT_SYSTEM_PROMPT=You are a supportive, concise onboard assistant for astronauts in the Bhartiya Antariksh Station. Encourage calm breathing, practical steps, and safety.

# Fusion weights
FUSION_VIDEO_WEIGHT=0.6
FUSION_AUDIO_WEIGHT=0.4

# Thresholds and alerts
CRITICAL_STRESS_THRESHOLD=0.8

# Features
INDIAN_VOICE=true
ENABLE_AVATAR=true
SEED_ROSTER=true

# Frontend
VITE_BACKEND_URL=http://localhost:8000

# Optional AWS (not required)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_LOG_BUCKET=